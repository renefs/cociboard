# Copy to `.env` next to docker-compose.yml and adjust. Every value is optional.

# Port on the host (open http://<host>:8000).
COCIBOARD_PORT=8000

# Owner of ./data. On Synology, run `id` in SSH as the user who owns the folder
# (typically uid=1026, gid=100 "users").
PUID=1000
PGID=1000

# Time zone used to decide "today" and the current week.
TZ=Europe/Madrid

# Add the starter recipes when the database is empty.
COCIBOARD_SEED_ON_STARTUP=true

# Only for docker-compose.ghcr.yml: image tag to run (latest, a version such as 0.8.0,
# or main).
COCIBOARD_TAG=latest

# Optional household password. Leave both empty for no login (fine on a home network).
# Set ONE of them; the hash wins if both are set. A plain password in this file can be read
# by anyone with access to it, so prefer the hash:
#   docker compose run --rm cociboard python -m cociboard.auth hash
# Changing the password logs everyone out. Use HTTPS (reverse proxy) when exposed.
COCIBOARD_PASSWORD=
COCIBOARD_PASSWORD_HASH=
# Signs session cookies. Optional: by default a random key is stored in ./data/cociboard.secret.
COCIBOARD_SECRET_KEY=

# Automatic copies of the database. Hours between copies (0 = off; a copy is only made if the
# data changed), how many to keep, and an optional folder inside the container for them
# (e.g. /data/backups, which is ./data/backups on the host; default: next to the database).
COCIBOARD_BACKUP_INTERVAL_HOURS=
COCIBOARD_BACKUPS_KEPT=
COCIBOARD_BACKUP_DIR=

# "Import from a link" on the new-recipe form: the server downloads the page the user pastes and
# reads its recipe (public web addresses only). Set to false to turn it off. Default: true.
COCIBOARD_RECIPE_IMPORT=
